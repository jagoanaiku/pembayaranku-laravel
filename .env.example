# Keep all credentials server-side. Use the matching key prefix and environment.
PEMBAYARANKU_API_KEY=
PEMBAYARANKU_ENVIRONMENT=sandbox
PEMBAYARANKU_BASE_URL=https://www.pembayaranku.com/api/v1
PEMBAYARANKU_TIMEOUT_SECONDS=15

# Separate signing secrets for the Live and Sandbox webhook endpoints.
PEMBAYARANKU_WEBHOOK_SECRET_LIVE=
PEMBAYARANKU_WEBHOOK_SECRET_SANDBOX=

# Fully qualified class implementing PembayaranKu\Laravel\Contracts\WebhookHandler
PEMBAYARANKU_WEBHOOK_HANDLER=
